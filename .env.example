# Copie para .env.local (no seu computador) ou cole na Vercel em Settings → Environment Variables.
# Sem as duas primeiras, o app roda em "modo local" (só no aparelho, sem backup).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lembrete de domingo (Web Push). Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Só na Vercel, NUNCA no código nem em chat:
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
